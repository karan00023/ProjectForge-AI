# Copy to backend/.env for local development. Never commit real credentials.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://projectforge:projectforge@localhost:5432/projectforge
# One-click synthetic personas on the login page. Disable for any deployment with real data.
DEMO_MODE=true
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
