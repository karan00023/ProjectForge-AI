    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "clsx": "2.1.1",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
